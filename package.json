{
  "name": "bug-hunt-race",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle:check": "tsx scripts/check-bundle-size.ts",
    "fixes:check": "tsx scripts/check-fix-leaks.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:multiplayer": "playwright test e2e/multiplayer",
    "smoke:live": "playwright test e2e/live --retries=0",
    "load:room": "tsx scripts/load/room-30.ts",
    "puzzles:check": "tsx scripts/check-puzzles.ts",
    "puzzles:build": "tsx scripts/build-puzzle-index.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > lib/db/types.ts && prettier --write lib/db/types.ts",
    "postinstall": "node scripts/copy-pyodide.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.117.3",
    "monaco-editor": "^0.57.0",
    "next": "16.4.0",
    "pyodide": "314.0.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
