{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bug Hunt Race puzzle",
  "description": "puzzle.json in puzzles/<language>/<level>/<id>/. Mirrors validatePuzzleMeta in lib/puzzles/schema.ts, which is what the checker runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "language",
    "level",
    "description",
    "hint",
    "bugCount",
    "timeLimitSec",
    "basePoints",
    "tags"
  ],
  "properties": {
    "id": {
      "description": "Kebab-case, unique across all puzzles, equal to the folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "language": { "enum": ["javascript", "typescript", "python"] },
    "level": { "enum": ["easy", "medium", "hard"] },
    "description": {
      "description": "What the code is supposed to do.",
      "type": "string",
      "minLength": 1
    },
    "hint": { "type": "string", "minLength": 1 },
    "bugCount": { "type": "integer", "minimum": 1, "maximum": 5 },
    "timeLimitSec": { "type": "integer" },
    "basePoints": { "type": "integer" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "level": { "const": "easy" } } },
      "then": {
        "properties": {
          "timeLimitSec": { "const": 180 },
          "basePoints": { "const": 100 }
        }
      }
    },
    {
      "if": { "properties": { "level": { "const": "medium" } } },
      "then": {
        "properties": {
          "timeLimitSec": { "const": 300 },
          "basePoints": { "const": 200 }
        }
      }
    },
    {
      "if": { "properties": { "level": { "const": "hard" } } },
      "then": {
        "properties": {
          "timeLimitSec": { "const": 480 },
          "basePoints": { "const": 300 }
        }
      }
    }
  ]
}
